{
  "name": "twitch-overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Zone-ops OBS streaming overlay with reactive scavenger avatar",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "npm run build && npm start",
    "companion": "node companion/index.js",
    "test:protocol": "tsx scripts/test-protocol.ts",
    "test:streamlabs": "tsx scripts/test-streamlabs-bridge.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io-client": "^2.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/socket.io-client": "^1.4.36",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "playwright": "^1.65.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
